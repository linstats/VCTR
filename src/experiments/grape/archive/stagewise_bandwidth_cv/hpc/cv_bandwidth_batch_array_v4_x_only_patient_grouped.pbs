#!/bin/bash
#PBS -N grape_cv_bw_xonly_v4
#PBS -J 1-5
#PBS -l select=1:ncpus=12:mem=64gb
#PBS -l walltime=36:00:00
#PBS -o /home/svu/e0829076/2026-tensor/src/experiments/grape/hpc/logs/
#PBS -e /home/svu/e0829076/2026-tensor/src/experiments/grape/hpc/logs/

set -euo pipefail

REPO="/home/svu/e0829076/2026-tensor"
PY="$HOME/conda-envs/vctr-py310/bin/python"
TASKS="src/experiments/grape/hpc/cv_bandwidth_tasks_v4_x_only_patient_grouped.csv"
BATCHES="src/experiments/grape/hpc/cv_bandwidth_batches_v4_x_only_patient_grouped.csv"

cd "$REPO"
mkdir -p src/experiments/grape/hpc/logs

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

"$PY" src/experiments/grape/modeling/run_cv_bandwidth_batch.py \
  --batch-csv "$BATCHES" \
  --batch-index "$PBS_ARRAY_INDEX" \
  --task-csv "$TASKS" \
  --max-workers 6 \
  --a-eval-mode anchor_grid \
  --a-eval-num-points 80
