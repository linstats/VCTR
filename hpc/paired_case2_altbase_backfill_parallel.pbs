#!/bin/bash
#PBS -N paired_c2_bf
#PBS -q parallel
#PBS -l select=1:ncpus=12:mem=16gb
#PBS -l walltime=72:00:00
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-$HOME/2026-tensor}"
CONDA_MODULE="${CONDA_MODULE:-miniconda/4.12}"
CONDA_ENV_PATH="${CONDA_ENV_PATH:-$HOME/conda-envs/vctr-py310}"

MANIFEST_PATH="${MANIFEST_PATH:?MANIFEST_PATH must be set}"
RUN_NAME="${RUN_NAME:?RUN_NAME must be set}"
N_JOBS="${N_JOBS:-12}"

R="${R:-6}"
S="${S:-27}"
P0="${P0:-4}"
BETA="${BETA:-2.0,1.0,-1.0,0.5}"
SIGMA2="${SIGMA2:-1.0}"
COVARIANCE_MODE="${COVARIANCE_MODE:-exchangeable_varying_sigma}"
SIGNAL_BANDWIDTH="${SIGNAL_BANDWIDTH:-0.20}"
VARIANCE_BANDWIDTH="${VARIANCE_BANDWIDTH:-0.20}"
RIDGE="${RIDGE:-1e-4}"

module purge
module load "$CONDA_MODULE"
source activate "$CONDA_ENV_PATH"

cd "$PROJECT_ROOT"

echo "[info] host=$(hostname)"
echo "[info] started_at=$(date)"
echo "[info] project_root=$PROJECT_ROOT"
echo "[info] manifest_path=$MANIFEST_PATH"
echo "[info] run_name=$RUN_NAME n_jobs=$N_JOBS"
echo "[info] python=$(command -v python)"
python --version
echo "[info] R=$R S=$S p0=$P0 beta=$BETA sigma2=$SIGMA2 covariance_mode=$COVARIANCE_MODE"
echo "[info] signal_bandwidth=$SIGNAL_BANDWIDTH variance_bandwidth=$VARIANCE_BANDWIDTH ridge=$RIDGE"

python src/experiments/paired_case2_altbase_repetition/paired_case2_altbase_backfill.py \
  --manifest "$MANIFEST_PATH" \
  --run-name "$RUN_NAME" \
  --R "$R" \
  --S "$S" \
  --p0 "$P0" \
  --beta "$BETA" \
  --sigma2 "$SIGMA2" \
  --covariance-mode "$COVARIANCE_MODE" \
  --signal-bandwidth "$SIGNAL_BANDWIDTH" \
  --variance-bandwidth "$VARIANCE_BANDWIDTH" \
  --ridge "$RIDGE" \
  --n-jobs "$N_JOBS"

echo "[info] finished_at=$(date)"
