#!/bin/bash
#PBS -N paired_c1_b56
#PBS -q parallel
#PBS -l select=1:ncpus=12:mem=12gb
#PBS -l walltime=40:00:00
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-$HOME/2026-tensor}"
CONDA_MODULE="${CONDA_MODULE:-miniconda/4.12}"
CONDA_ENV_PATH="${CONDA_ENV_PATH:-$HOME/conda-envs/vctr-py310}"

N_JOBS="${N_JOBS:-12}"
N_REP="${N_REP:-4}"
SEED_BASE="${SEED_BASE:-123}"
RUN_ROOT="${RUN_ROOT:-hpc_runs/a5a6_allsigma/hpc_raw_parts}"
PART_ID="${PART_ID:-1}"

N_SUBJECT_VALUES="${N_SUBJECT_VALUES:-1000 2000}"
COEF_TYPES="${COEF_TYPES:-base5 base6}"
SIGMA2_FUNCTIONS="${SIGMA2_FUNCTIONS:-constant sin sin2 mixed}"
RHO_VALUES="${RHO_VALUES:-0.0 0.3 0.6 0.9}"

R="${R:-4}"
S="${S:-25}"
P0="${P0:-4}"
BETA="${BETA:-2.0,1.0,-1.0,0.5}"
SIGMA2="${SIGMA2:-1.0}"
COVARIANCE_MODE="${COVARIANCE_MODE:-exchangeable_varying_sigma}"
SIGNAL_BANDWIDTH="${SIGNAL_BANDWIDTH:-0.18}"
VARIANCE_BANDWIDTH="${VARIANCE_BANDWIDTH:-0.18}"
RIDGE="${RIDGE:-1e-4}"

module purge
module load "$CONDA_MODULE"
source activate "$CONDA_ENV_PATH"

cd "$PROJECT_ROOT"

RUN_NAME="${RUN_ROOT}/part${PART_ID}"

echo "[info] host=$(hostname)"
echo "[info] started_at=$(date)"
echo "[info] project_root=$PROJECT_ROOT"
echo "[info] conda_module=$CONDA_MODULE"
echo "[info] conda_env_path=$CONDA_ENV_PATH"
echo "[info] python=$(command -v python)"
python --version
echo "[info] n_jobs=$N_JOBS n_rep=$N_REP seed_base=$SEED_BASE part_id=$PART_ID"
echo "[info] run_root=$RUN_ROOT run_name=$RUN_NAME"
echo "[info] n_subject_values=$N_SUBJECT_VALUES coef_types=$COEF_TYPES sigma2_functions=$SIGMA2_FUNCTIONS rho_values=$RHO_VALUES"
echo "[info] R=$R S=$S p0=$P0 beta=$BETA sigma2=$SIGMA2 covariance_mode=$COVARIANCE_MODE"
echo "[info] signal_bandwidth=$SIGNAL_BANDWIDTH variance_bandwidth=$VARIANCE_BANDWIDTH ridge=$RIDGE"

python src/experiments/case1_2d_repetition.py \
  --n-subject-values ${N_SUBJECT_VALUES} \
  --coef-types ${COEF_TYPES} \
  --sigma2-functions ${SIGMA2_FUNCTIONS} \
  --n-rep "$N_REP" \
  --seed-base "$SEED_BASE" \
  --R "$R" \
  --S "$S" \
  --p0 "$P0" \
  --beta "$BETA" \
  --sigma2 "$SIGMA2" \
  --rho-values ${RHO_VALUES} \
  --covariance-mode "$COVARIANCE_MODE" \
  --signal-bandwidth "$SIGNAL_BANDWIDTH" \
  --variance-bandwidth "$VARIANCE_BANDWIDTH" \
  --ridge "$RIDGE" \
  --n-jobs "$N_JOBS" \
  --run-name "$RUN_NAME"

echo "[info] finished_at=$(date)"
